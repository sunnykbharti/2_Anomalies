# ============================================================
# PostureTrek Backend — Environment Configuration Template
# Copy this file to .env and configure your variables.
# ============================================================

# ── Flask Environment ─────────────────────────────────────────
FLASK_ENV=development        # set to 'production' for strict security
FLASK_DEBUG=false            # set to 'true' only during local frontend/backend debugging

# ── Security Keys (REQUIRED in production) ────────────────────
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=posturetrek-super-secret-key-change-in-production
JWT_SECRET_KEY=posturetrek-jwt-secret-key-change-in-production

# ── Rate Limiting (Flask-Limiter) ──────────────────────────────
# Storage backend: memory:// for local/single-worker, or redis://localhost:6379 for cluster
RATELIMIT_STORAGE_URI=memory://

# ── Live Email Delivery (SMTP / Gmail / SendGrid / Custom) ─────
# To deliver real OTPs to mail, provide your SMTP credentials:
# For Gmail: Use your Gmail address and generate a 16-character App Password
# at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER="PostureTrek Security <no-reply@posturetrek.io>"

# ── CORS (Allowed Origins) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# ── Database ──────────────────────────────────────────────────
# Defaults to instance/postretrek.sqlite if not specified.
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost:5432/posturetrek

# ── AI Providers (Optional) ───────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:latest
# GEMINI_API_KEY=your-gemini-api-key-here
